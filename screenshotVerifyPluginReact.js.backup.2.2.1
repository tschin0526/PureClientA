    });

    // 动态生成表格行
    var bodyRows = data.map(function(r, i) {
      var bg = i % 2 === 0 ? '#ffffff' : '#f8fafc';
      
      var cells = columnDefs.map(function(col) {
        var value = r[col.key];
        var cellStyle = {
          padding: '6px 8px',
          borderBottom: '1px solid #edf2f2',
          textAlign: col.align,
          fontFamily: col.fontMono ? 'monospace' : 'inherit',
          fontSize: col.fontMono ? '11px' : '13px',
          whiteSpace: col.key === '股票名称' || col.key === '名称' ? 'nowrap' : 'normal',
          overflow: 'hidden',
          textOverflow: 'ellipsis'
        };
        
        // ✅ v2.1.1: 对于RAW_TEXT模板，空值用特殊样式标记
        var isEmptyValue = (value === undefined || value === null || value === '');
        if (templateId === 'RAW_TEXT' && isEmptyValue) {
          cellStyle.background = '#fef3c7';  // 浅黄色背景
          cellStyle.color = '#92400e';       // 橙色文字
          cellStyle.fontStyle = 'italic';
        }
        
        // 应用颜色
        if (col.enumColors && col.enumColors[value]) {
          cellStyle.color = col.enumColors[value];
          if (col.bold || (col.key === '方向' || col.key === '市场')) {
            cellStyle.fontWeight = 700;
          }
        } else if (col.color && !isEmptyValue) {
          cellStyle.color = col.color;
        }
        
        if (col.bold) {
          cellStyle.fontWeight = col.bold ? 700 : 400;
        }
        
        // 格式化数字或显示值
        var displayValue;
        if (isEmptyValue) {
          displayValue = createElement('span', { style: { color: '#d97706', fontSize: '11px' } }, '(空)');
        } else {
          displayValue = col.formatNumber ? formatNumber(value) : escapeHtml(value);
        }
        
        // 特殊处理：名称字段加粗（非RAW_TEXT模板）
        if ((col.key === '名称' || col.key === '股票名称') && templateId !== 'RAW_TEXT') {
          displayValue = createElement('strong', { style: { color: col.color || '#1a202c' } }, displayValue);
        }
        
        return createElement('td', { key: col.key, style: cellStyle }, displayValue);
      });

      return createElement('tr', { key: i, style: { background: bg } }, cells);
    });

