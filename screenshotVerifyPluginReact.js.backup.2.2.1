  // ===== 辅助函数：解析内联样式 =====
  function parseInlineStyle(styleStr) {
    if (!styleStr) return {};
    var obj = {};
    styleStr.split(';').forEach(function(s) {
      var parts = s.split(':');
      if (parts.length === 2) {
        var k = parts[0].trim();
        var v = parts[1].trim();
        if (k && v) obj[k] = v;
      }
    });
    return obj;
  }

  // ===== 子组件：数据表格（支持多模板） =====
  function DataTable({ data, templateId }) {
    if (!data || !data.length) return null;

    // ✨ v2.1.0: 根据模板ID动态生成表格列定义
    var currentTemplate = TEMPLATE_REGISTRY.find(function(t) { return t.templateId === templateId; }) || TRADE_SCHEMA;
    
    var columnDefs = [];
    var summaryStats = [];
    
    if (templateId === 'RAW_TEXT') {
      // ✅ v2.1.1: 原始文本默认模板 - 动态显示所有OCR提取的字段
      // 收集所有数据中出现的字段名
      var allFields = {};
      data.forEach(function(record) {
        Object.keys(record).forEach(function(key) {
          allFields[key] = true;
        });
      });
      
      var dynamicFieldNames = Object.keys(allFields);
      
      // 动态生成列定义
      columnDefs = dynamicFieldNames.map(function(fieldName, idx) {
        return {
          key: fieldName,
          label: fieldName,
          width: idx === 0 ? '150px' : '120px',  // 第一列稍宽
          align: 'left',
          color: '#4a5568'
        };
      });
      
      // 统计摘要：显示记录数和字段数
      summaryStats = [
        { label: '共 ' + data.length + ' 条记录', bg: '#fef3c7', color: '#92400e' },
        { label: dynamicFieldNames.length + ' 个字段', bg: '#e0e7ff', color: '#3730a3' },
        { label: '未规范数据', bg: '#fee2e2', color: '#991b1b' }
      ];
      
    } else if (templateId === 'STOCK_INVENTORY') {
      // 股票清单模板的列定义
      columnDefs = [
        { key: '股票代码', label: '股票代码', width: '90px', align: 'left', fontMono: true, color: '#718096' },
        { key: '股票名称', label: '股票名称', width: '120px', align: 'left', bold: true, color: '#1a202c' },
        { key: '截图用名称', label: '截图用名称', width: '110px', align: 'left', color: '#4a5568' },
        { key: '单位', label: '单位', width: '60px', align: 'center', color: '#718096' },
        { key: '市场', label: '市场', width: '65px', align: 'center', enumColors: {'台股': '#065f46', '陆股': '#92400e', '美股': '#1e40af'} },
        { key: '类型', label: '类型', width: '60px', align: 'center', fontMono: true, color: '#6d28d9' },
        { key: '买入数量', label: '买入数量', width: '85px', align: 'right', formatNumber: true, color: '#065f46' },
        { key: '卖出数量', label: '卖出数量', width: '85px', align: 'right', formatNumber: true, color: '#991b1b' },
        { key: '结余数量', label: '结余数量', width: '85px', align: 'right', formatNumber: true, bold: true, color: '#1a202c' }
      ];
      
      // 统计摘要
      var totalBuyQty = data.reduce(function(sum, d) { return sum + (parseInt(d['买入数量']) || 0); }, 0);
      var totalSellQty = data.reduce(function(sum, d) { return sum + (parseInt(d['卖出数量']) || 0); }, 0);
      var totalBalance = data.reduce(function(sum, d) { return sum + (parseInt(d['结余数量']) || 0); }, 0);
      
      summaryStats = [
        { label: '共 ' + data.length + ' 只', bg: '#ede9fe', color: '#6d28d9' },
        { label: '买入 ' + formatNumber(totalBuyQty), bg: '#d1fae5', color: '#065f46' },
        { label: '卖出 ' + formatNumber(totalSellQty), bg: '#fee2e2', color: '#991b1b' },
        { label: '结余 ' + formatNumber(totalBalance), bg: '#e0e7ff', color: '#3730a3' }
      ];
      
    } else {
      // 默认：光大证券金阳光交易记录模板
      columnDefs = [
        { key: '名称', label: '名称', width: '140px', align: 'left', bold: true, color: '#1a202c' },
        { key: '股号', label: '股号', width: '75px', align: 'left', fontMono: true, color: '#718096' },
        { key: '价格', label: '价格', width: '75px', align: 'right', fontMono: true, color: '#2d3748' },
        { key: '数量', label: '数量', width: '70px', align: 'right', formatNumber: true, color: '#4a5568' },
        { key: '方向', label: '方向', width: '48px', align: 'center', enumColors: {'买入': '#065f46', '卖出': '#991b1b'}, bold: true },
        { key: '成交额', label: '成交额', width: '130px', align: 'right', formatNumber: true, bold: true, color: '#1a202c' }
      ];
      
      var buyCount = data.filter(function(d) { return d['方向'] === '买入'; }).length;
      var sellCount = data.filter(function(d) { return d['方向'] === '卖出'; }).length;
      
      summaryStats = [
        { label: '共 ' + data.length + ' 笔', bg: '#ede9fe', color: '#6d28d9' },
        { label: '买入 ' + buyCount, bg: '#d1fae5', color: '#065f46' },
        { label: '卖出 ' + sellCount, bg: '#fee2e2', color: '#991b1b' }
      ];
    }

    // 动态生成表头
    var headerCells = columnDefs.map(function(col) {
      return createElement('th', { 
        key: 'h-' + col.key, 
