  // ===== 子组件：原始文本显示（用于未规范数据） =====
  function RawTextDisplay({ data, images }) {
    if (!data || !data.length) return null;

    // 收集所有截图的原始OCR文本
    var allTexts = [];
    
    images.forEach(function(img, idx) {
      if (img.ocrText) {
        allTexts.push({
          index: idx + 1,
          name: img.name || ('截图' + (idx + 1)),
          text: img.ocrText,
          isRawText: img.templateId === 'RAW_TEXT'
        });
      }
      // ✅ v2.1.2: 不再显示"提取的字段"信息，因为对于未规范数据这些字段都是错误的
    });

    // 如果没有从images获取到文本，使用data生成简化的文本
    if (allTexts.length === 0 && data.length > 0) {
      var combinedText = data.map(function(record, i) {
        var lines = Object.keys(record).map(function(key) {
          return key + ': ' + (record[key] || '(空)');
        });
        return '【记录 ' + (i+1) + '】\n' + lines.join('\n');
      }).join('\n\n');
      
      allTexts.push({
        index: 1,
        name: '提取数据',
        text: combinedText,
        isRawText: true
      });
    }

    return createElement('div', null,
      // 标题栏
      createElement('div', {
        style: {
          marginBottom: '12px',
          display: 'flex',
          alignItems: 'center',
          gap: '16px',
          flexWrap: 'wrap'
        }
      },
        createElement('span', { style: { fontSize: '15px', fontWeight: 700, color: '#2d3748' } }, 
          '📄 原始文本'),
        createElement('div', { style: { display: 'flex', gap: '10px', flex: 1, justifyContent: 'flex-end' } },
          createElement('span', { style: { background: '#fef3c7', color: '#92400e', padding: '4px 14px', borderRadius: '20px', fontSize: '12px', fontWeight: 600 } },
            '共 ' + allTexts.length + ' 个来源'
