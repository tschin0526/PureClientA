## 升级规则

- 日常小修改（样式调整、Bug 修复）：\`./update_version.sh\`（构建号 +1）
- 功能新增/优化：\`./update_version.sh patch\`（修订版本 +1）
- 重大功能升级：\`./update_version.sh minor\`（次版本 +1）
- 架构级变更：\`./update_version.sh major\`（主版本 +1）
`;

  function markdownToHtml(md) {
    var lines = md.split('\n');
    var html = [];
    var inList = false;
    var inCodeBlock = false;
    
    for (var i = 0; i < lines.length; i++) {
      var line = lines[i];
      
      if (line.trim().startsWith('```')) {
        if (inCodeBlock) {
          html.push('</code></pre>');
          inCodeBlock = false;
        } else {
          if (inList) { html.push('</ul>'); inList = false; }
          html.push('<pre style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;padding:12px;overflow-x:auto;font-size:13px;line-height:1.5;"><code>');
          inCodeBlock = true;
        }
        continue;
      }
      
      if (inCodeBlock) {
        html.push(escapeHtml(line));
        continue;
      }
      
      var h3Match = line.match(/^### (.+)$/);
      if (h3Match) {
        if (inList) { html.push('</ul>'); inList = false; }
        html.push('<h3 style="font-size:16px;font-weight:bold;color:#2563eb;margin:14px 0 8px;background:#eff6ff;padding:8px 12px;border-radius:6px;">' + h3Match[1] + '</h3>');
        continue;
      }
      
      var h2Match = line.match(/^## (.+)$/);
      if (h2Match) {
        if (inList) { html.push('</ul>'); inList = false; }
        html.push('<h2 style="font-size:18px;font-weight:bold;color:#1f2937;margin:20px 0 12px;border-bottom:2px solid #e5e7eb;">' + h2Match[1] + '</h2>');
        continue;
      }
      
      var listMatch = line.match(/^- (.+)$/);
      if (listMatch) {
        if (!inList) {
          html.push('<ul style="margin:0;padding-left:24px;font-size:14px;color:#374151;line-height:1.8;">');
          inList = true;
        }
        var content = listMatch[1]
          .replace(/\*\*(.+?)\*\*/g, '<strong style="color:$1">$1</strong>')
          .replace(/`([^`]+)`/g, '<code style="background:#f1f5f9;padding:1px 4px;border-radius:3px;font-size:13px;color:#dc2626;">$1</code>')
          .replace(/【新增】/g, '<span style="color:#059669;font-weight:bold;">【新增】</span>')
          .replace(/【修改】/g, '<span style="color:#2563eb;font-weight:bold;">【修改】</span>')
          .replace(/✅/g, '<span style="color:#10b981;">✅</span>')
          .replace(/🎯/g, '🎯')
          .replace(/📝/g, '📝')
          .replace(/🏗️/g, '🏗️')
          .replace(/✨/g, '✨')
          .replace(/🔧/g, '🔧')
          .replace(/💾/g, '💾')
          .replace(/🆕/g, '🆕')
          .replace(/🤖/g, '🤖')
          .replace(/📦/g, '📦')
          .replace(/📊/g, '📊')
          .replace(/📝/g, '📝')
          .replace(/🪄/g, '🪄')
          .replace(/🔧/g, '🔧');
        
        content = content
          .replace(/<strong style="color:(.+?)">(.+?)<\/strong>/g, '<strong style="color:#059669;">$2</strong>')
          .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>');
        
        html.push('<li style="margin:4px 0;">' + content + '</li>');
        continue;
      }
      
      if (inList && line.trim() === '') {
        continue;
      }
      
      if (inList) { html.push('</ul>'); inList = false; }
      
      if (line.trim() !== '') {
        var pText = line
          .replace(/`([^`]+)`/g, '<code style="background:#f1f5f9;padding:1px 4px;border-radius:3px;font-size:13px;color:#dc2626;">$1</code>');
        html.push('<p style="margin:8px 0;font-size:14px;color:#374151;">' + pText + '</p>');
      }
    }
    
    if (inList) html.push('</ul>');
    if (inCodeBlock) { html.push('</code></pre>'); }
    
    return html.join('\n');
  }
  
  function escapeHtml(text) {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
  }
  
  // React 挂载容器与根实例
  var reactRoot = null;
  var reactContainer = null;

  function ensureReactContainer() {
    if (reactContainer) {
      return reactContainer;
    }
    reactContainer = document.createElement('div');
    reactContainer.id = 'version-history-plugin-react-container';
    document.body.appendChild(reactContainer);
    return reactContainer;
  }

  function cleanupReactContainer() {
    if (reactRoot) {
      try {
        reactRoot.unmount();
      } catch (e) {
        console.warn('VersionHistoryPluginReact cleanup failed:', e);
      }
      reactRoot = null;
    }
    if (reactContainer && reactContainer.parentNode) {
      reactContainer.parentNode.removeChild(reactContainer);
      reactContainer = null;
    }
  }

  function renderVersionHistoryWindow() {
    if (typeof React === 'undefined' || typeof ReactDOM === 'undefined' || typeof FloatingWindowReact === 'undefined') {
      console.error('VersionHistoryPluginReact: React / ReactDOM / FloatingWindowReact 未加载');
      return;
    }

    var container = ensureReactContainer();
    if (!reactRoot) {
      reactRoot = ReactDOM.createRoot(container);
    }

    var contentElement = React.createElement('div', {
      style: {
        padding: '24px',
        fontFamily: '-apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif',
        lineHeight: '1.6'
      },
      dangerouslySetInnerHTML: { __html: markdownToHtml(VERSION_DATA) }
    });

    reactRoot.render(
      React.createElement(FloatingWindowReact, {
        title: '📦 版本历史',
        sourceFile: 'versionHistoryPluginReact.js',
        width: '750px',
        height: '85vh',
        draggable: true,
        closeAnimation: 'fade',
        onHide: function() {
          cleanupReactContainer();
        }
      }, contentElement)
    );
  }

  return {
    show: function() {
      renderVersionHistoryWindow();
    },
    
    close: function() {
      cleanupReactContainer();
    },
    
    getLatestVersion: function() {
      var match = VERSION_DATA.match(/(\d+\.\d+\.\d+\(\d+\))/);
      return match ? match[1] : 'unknown';
    }
  };
})();

console.log('✅ VersionHistoryPluginReact 已加载，版本号按钮onclick可直接调用show()');

(function() {
  var el = document.getElementById('versionIndicator');
  if (el) {
    el.textContent = '📦 ' + VersionHistoryPlugin.getLatestVersion();
  }
})();
