self.addEventListener('install', (event) => {
  console.log('[SW v5] 安装开始...');
  event.waitUntil(
    caches.open(CACHE_NAME).then((cache) => {
      console.log('[SW v5] 正在预缓存所有资源...');
      return cache.addAll(STATIC_ASSETS).then(() => {
        console.log('[SW v5] 静态资源缓存完成');
        return Promise.all(
          CDN_ASSETS.map(url =>
            cache.add(url).catch(err => {
              console.warn('[SW v5] CDN 缓存失败:', url);
              return Promise.resolve();
            })
          )
        );
      }).then(() => {
        console.log('[SW v5] 所有资源缓存完成');
      });
    }).then(() => {
      console.log('[SW v5] 安装完成，跳过等待激活');
      return self.skipWaiting();
    })
  );
});

self.addEventListener('activate', (event) => {
  console.log('[SW v7] 激活开始...');
  event.waitUntil(
    caches.keys().then((cacheNames) => {
      // 开发环境：清除所有旧缓存
      const deletePromises = cacheNames
        .filter(name => {
          // 只保留当前版本的缓存
          return name !== CACHE_NAME;
        })
        .map(name => {
          console.log('[SW v7] 删除旧缓存:', name);
          return caches.delete(name);
        });

      return Promise.all(deletePromises);
    }).then(() => {
      console.log('[SW v7] 缓存清理完成');
      return self.clients.claim();
    }).then(() => {
      console.log('[SW v7] 激活完成，已接管所有客户端');
      // 通知所有客户端新版本已激活
      return self.clients.matchAll().then(clients => {
        clients.forEach(client => {
          client.postMessage({
            type: 'UPDATE_AVAILABLE',
            version: CACHE_NAME
          });
        });
      });
    })
  );
});

self.addEventListener('fetch', (event) => {
  const request = event.request;
  const url = new URL(request.url);

  if (request.method !== 'GET') {
    return;
  }

  // 检查是否是开发环境（localhost、127.0.0.1 或本地网络 IP）
  const isDev = url.hostname === 'localhost' || 
                url.hostname === '127.0.0.1' ||
                url.hostname.startsWith('192.168.') ||
                url.hostname.startsWith('10.') ||
                url.hostname.startsWith('172.');

  event.respondWith(
    (async () => {
      try {
        // 开发环境：优先从网络获取
        if (isDev) {
          console.log('[SW v7] 开发模式，优先从网络获取');
          try {
            const networkResponse = await fetch(request);
            if (networkResponse.ok) {
              const cache = await caches.open(CACHE_NAME);
              cache.put(request, networkResponse.clone());
            }
            return networkResponse;
          } catch (err) {
            console.log('[SW v7] 网络失败，尝试缓存');
            const cachedResponse = await caches.match(request);
            if (cachedResponse) {
              return cachedResponse;
            }
            return new Response(OFFLINE_PAGE, {
              status: 200,
              headers: { 'Content-Type': 'text/html; charset=utf-8' }
            });
          }
        }

        // 生产环境：原有的缓存策略
        if (request.mode === 'navigate') {
          console.log('[SW v7] 导航请求:', url.pathname);

          let cachedResponse = await caches.match(request);
          if (!cachedResponse) {
            cachedResponse = await caches.match(ROOT_URL);
          }
          if (!cachedResponse) {
            cachedResponse = await caches.match(INDEX_URL);
          }

          if (cachedResponse) {
            console.log('[SW v7] ✅ 从缓存返回页面');
            return cachedResponse;
          }

          try {
            const networkResponse = await fetch(request);
            if (networkResponse.ok) {
              const cache = await caches.open(CACHE_NAME);
              cache.put(request, networkResponse.clone());
            }
            return networkResponse;
          } catch (err) {
            console.log('[SW v7] ⚠️ 网络失败，返回离线页面');
            return new Response(OFFLINE_PAGE, {
              status: 200,
              headers: { 'Content-Type': 'text/html; charset=utf-8' }
            });
          }
        }

        if (url.origin !== self.location.origin) {
          const cachedResponse = await caches.match(request);
          if (cachedResponse) {
            return cachedResponse;
          }
          try {
            const networkResponse = await fetch(request);
            if (networkResponse.ok) {
              const cache = await caches.open(CACHE_NAME);
              cache.put(request, networkResponse.clone());
            }
            return networkResponse;
          } catch (err) {
             
            return new Response('', { status: 404 });
          }
        }

        const cachedResponse = await caches.match(request);
        if (cachedResponse) {
          try {
            const networkResponse = await fetch(request);
            if (networkResponse && networkResponse.status === 200 && networkResponse.type === 'basic') {
              const cache = await caches.open(CACHE_NAME);
              cache.put(request, networkResponse.clone());
            }
          } catch (err) {}
          return cachedResponse;
        }

        try {
          const networkResponse = await fetch(request);
          if (networkResponse && networkResponse.status === 200 && networkResponse.type === 'basic') {
            const cache = await caches.open(CACHE_NAME);
            cache.put(request, networkResponse.clone());
          }
          return networkResponse;
        } catch (err) {
          return new Response('', { status: 404 });
        }
      } catch (error) {
        console.error('[SW v7] fetch 处理错误:', error);
        return new Response(OFFLINE_PAGE, {
          status: 200,
          headers: { 'Content-Type': 'text/html; charset=utf-8' }
        });
      }
    })()
  );
});

self.addEventListener('message', (event) => {
  if (event.data && event.data.type === 'SKIP_WAITING') {
    self.skipWaiting();
  }
  if (event.data && event.data.type === 'GET_VERSION') {
    event.ports[0].postMessage({ version: CACHE_NAME });
  }
});
