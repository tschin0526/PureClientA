const CACHE_NAME = 'pureClientA-1.5.1(30)';

// 智能作用域检测 - 支持子目录部署
const SW_SCOPE = (() => {
  if (self.registration && self.registration.scope) {
    return self.registration.scope;
  }
  // 从当前脚本位置推断作用域
  const scriptUrl = new URL(self.location.href);
  const pathParts = scriptUrl.pathname.split('/');
  pathParts.pop(); // 移除 sw.js 文件名
  return scriptUrl.origin + pathParts.join('/') + '/';
})();

const ROOT_URL = new URL('./', SW_SCOPE).href;
const INDEX_URL = new URL('./index.html', SW_SCOPE).href;
const MANIFEST_URL = new URL('./manifest.json', SW_SCOPE).href;

